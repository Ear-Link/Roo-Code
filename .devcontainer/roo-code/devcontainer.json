{
	"name": "Roo-code dev CPU",
	"dockerComposeFile": ["../docker-compose.roocode.yml"],
	"service": "roocode",
	"initializeCommand": "cd .devcontainer && docker compose -f docker-compose.roocode.yml build roocode ollama_cpu qdrant",
	"workspaceFolder": "/project",
	"customizations": {
		"vscode": {
			"settings": {
				"terminal.integrated.defaultProfile.linux": "bash",
				"idf.gitPath": "/usr/bin/git"
			},
			"extensions": ["rooveterinaryinc.roo-cline", "jrieken.vscode-tree-sitter-query"]
		}
	},
	"postCreateCommand": "pnpm install",
	"forwardPorts": [5173]
}
